apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: ssc-web
  namespace: ${namespace}
spec:
  secretName: ssc-web-tls
  dnsNames:
    - ${ssc_hostname}
  issuerRef:
    name: ${issuer_name}
    kind: ${issuer_kind}
    group: cert-manager.io
  privateKey:
    algorithm: RSA
    size: 2048
    rotationPolicy: Always
